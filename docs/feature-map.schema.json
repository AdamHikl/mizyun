{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MizyunFeatureMap",
  "type": "object",
  "required": ["schemaVersion", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "aliases",
          "entryPoints",
          "ownedPaths",
          "contracts",
          "domainPort",
          "api",
          "ui",
          "adapters",
          "dataTables",
          "migrationPaths",
          "tests",
          "relations",
          "docs",
          "verificationCommands",
          "lastReviewedSha",
          "lastReviewedDate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "entryPoints": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ownedPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contracts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "domainPort": {
            "type": "array",
            "items": { "type": "string" }
          },
          "api": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ui": {
            "type": "array",
            "items": { "type": "string" }
          },
          "adapters": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dataTables": {
            "type": "array",
            "items": { "type": "string" }
          },
          "migrationPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "target", "reason"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["dependsOn", "affects", "relatedTo"]
                },
                "target": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          },
          "docs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "verificationCommands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requirements": {
            "type": "array",
            "items": { "type": "string" }
          },
          "openAcceptance": {
            "type": "array",
            "items": { "type": "string" }
          },
          "lastReviewedSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "lastReviewedDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "limitations": { "type": "string" }
        }
      }
    }
  }
}
