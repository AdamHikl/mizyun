{
  "name": "mizyun",
  "version": "0.1.0",
  "private": true,
  "description": "A modular AI-ready fitness and nutrition app for iOS and Android.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mizyun/api --filter @mizyun/mobile dev",
    "dev:api": "pnpm --filter @mizyun/api dev",
    "dev:mobile": "pnpm --filter @mizyun/mobile start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:test": "supabase test db --local supabase/tests/database",
    "db:verify": "pnpm db:reset && pnpm db:lint && pnpm db:test",
    "db:link": "node scripts/db-link.mjs",
    "db:remote-status": "node scripts/db-remote-status.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:linked-test": "node scripts/db-linked-test.mjs",
    "db:preflight": "node scripts/db-preflight.mjs",
    "deploy:remote": "node scripts/deploy-remote.mjs",
    "mobile:founder-production:ios:prebuild": "bash scripts/mobile-founder-production-ios.sh prebuild",
    "mobile:founder-production:ios": "bash scripts/mobile-founder-production-ios.sh run",
    "mobile:founder-production:android:prebuild": "bash scripts/mobile-founder-production-android.sh prebuild",
    "mobile:founder-production:android:assembleRelease": "bash scripts/mobile-founder-production-android.sh assembleRelease",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "alpha:analyze": "tsx scripts/analyze-alpha-exports.ts",
    "ai:live-synthetic": "pnpm --filter @mizyun/provider-mistral exec vitest run src/live-synthetic.e2e.test.ts",
    "ai:eval:offline": "pnpm --filter @mizyun/agent-runtime test && pnpm --filter @mizyun/core test && pnpm --filter @mizyun/contracts test && pnpm --filter @mizyun/provider-mistral test && pnpm --filter @mizyun/api test",
    "ai:eval": "pnpm check && pnpm db:verify",
    "mem:smoke": "bash scripts/mem-001-smoke.sh",
    "vision:smoke": "bash scripts/vision-001-smoke.sh",
    "ai:smoke": "bash scripts/ai-ops-001-smoke.sh",
    "email:smoke": "tsx scripts/test-ses-email.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm --filter @mizyun/mobile bundle:check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "supabase": "2.109.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
