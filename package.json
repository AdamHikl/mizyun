{
  "name": "mizyun",
  "version": "0.1.0",
  "private": true,
  "description": "A modular AI-ready fitness and nutrition app for iOS and Android.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mizyun/api --filter @mizyun/mobile dev",
    "dev:api": "pnpm --filter @mizyun/api dev",
    "dev:mobile": "pnpm --filter @mizyun/mobile start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:test": "supabase test db --local supabase/tests/database",
    "db:verify": "pnpm db:reset && pnpm db:lint && pnpm db:test",
    "db:link": "node scripts/db-link.mjs",
    "db:remote-status": "node scripts/db-remote-status.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:linked-test": "node scripts/db-linked-test.mjs",
    "db:preflight": "node scripts/db-preflight.mjs",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "deploy:dev:preflight": "node scripts/preflight-dev-deploy.mjs",
    "deploy:production": "node scripts/deploy-remote.mjs",
    "deploy:production:preflight": "node scripts/preflight-production-deploy.mjs",
    "deploy:remote": "node scripts/deploy-remote.mjs",
    "backup:sync": "bash scripts/mac-daily-backup-sync.sh",
    "mobile:founder-dev:ios:prebuild": "bash scripts/mobile-founder-dev-ios.sh prebuild",
    "mobile:founder-dev:ios": "bash scripts/mobile-founder-dev-ios.sh run",
    "mobile:founder-production:ios:prebuild": "bash scripts/mobile-founder-production-ios.sh prebuild",
    "mobile:founder-production:ios": "bash scripts/mobile-founder-production-ios.sh run",
    "mobile:founder-production:ios:ipa": "bash scripts/build-production-ios-ipa.sh",
    "mobile:founder-dev:android:prebuild": "bash scripts/mobile-founder-dev-android.sh prebuild",
    "mobile:founder-dev:android:assembleRelease": "bash scripts/mobile-founder-dev-android.sh assembleRelease",
    "mobile:founder-dev:android": "bash scripts/mobile-founder-dev-android.sh run",
    "mobile:founder-production:android:prebuild": "bash scripts/mobile-founder-production-android.sh prebuild",
    "mobile:founder-production:android:assembleRelease": "bash scripts/mobile-founder-production-android.sh assembleRelease",
    "mobile:founder-production:android:bundleRelease": "bash scripts/mobile-founder-production-android.sh bundleRelease",
    "mobile:founder-production:android:signBundle": "bash scripts/sign-production-android-bundle.sh",
    "mobile:release-artifacts:list": "bash scripts/list-mobile-release-artifacts.sh",
    "mobile:install:ios:dev": "bash scripts/mobile-device-install.sh ios dev",
    "mobile:install:ios:production": "bash scripts/mobile-device-install.sh ios production",
    "mobile:install:ios:prod": "bash scripts/mobile-device-install.sh ios production",
    "mobile:install:android:dev": "bash scripts/mobile-device-install.sh android dev",
    "mobile:install:android:production": "bash scripts/mobile-device-install.sh android production",
    "mobile:install:android:prod": "bash scripts/mobile-device-install.sh android production",
    "mobile:eas:build:ios": "pnpm --filter @mizyun/mobile exec eas build --platform ios --profile production",
    "mobile:eas:build:android": "pnpm --filter @mizyun/mobile exec eas build --platform android --profile production",
    "mobile:eas:submit:ios": "pnpm --filter @mizyun/mobile exec eas submit --platform ios",
    "mobile:eas:submit:android": "pnpm --filter @mizyun/mobile exec eas submit --platform android",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "alpha:analyze": "tsx scripts/analyze-alpha-exports.ts",
    "analytics": "node scripts/product-analytics.mjs",
    "feedback": "node scripts/check-user-feedback.mjs",
    "beta-pro": "node scripts/check-beta-pro-requests.mjs",
    "beta-pro:check": "node scripts/check-beta-pro-requests.mjs",
    "ai:eval:offline": "pnpm --filter @mizyun/agent-runtime test && pnpm --filter @mizyun/core test && pnpm --filter @mizyun/contracts test && pnpm --filter @mizyun/provider-gemini test && pnpm --filter @mizyun/api test",
    "ai:eval": "pnpm check && pnpm db:verify",
    "mem:smoke": "bash scripts/mem-001-smoke.sh",
    "vision:smoke": "bash scripts/vision-001-smoke.sh",
    "ai:smoke": "bash scripts/ai-ops-001-smoke.sh",
    "email:smoke": "tsx scripts/test-ses-email.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "context": "node scripts/navigation/context.mjs",
    "impact": "node scripts/navigation/impact.mjs",
    "navigation:check": "node scripts/navigation/check.mjs",
    "test:navigation": "node --test scripts/navigation/test/*.test.mjs",
    "test:build-matrix": "node scripts/test-build-matrix.mjs",
    "test:production-android-signing-tooling": "node scripts/test-production-android-signing-tooling.mjs",
    "test:production-ios-ipa-tooling": "node scripts/test-production-ios-ipa-tooling.mjs",
    "test:deployment-safeguards": "node scripts/test-deployment-safeguards.mjs",
    "test:hetzner-operations": "node scripts/test-hetzner-operations.mjs && node --test scripts/test-hetzner-tunnel-isolation.mjs",
    "test:backup-retention": "node --test scripts/prune-backups.test.mjs",
    "test:exercise-catalog": "node --test scripts/import-exercise-catalog.test.mjs",
    "test:google-oauth-config": "node --test scripts/validate-google-oauth-env.test.mjs",
    "test:tier-authority": "node scripts/test-tier-authority-postgrest.mjs",
    "backup:verify": "bash scripts/verify-backup-recovery.sh",
    "test:community-operations": "node --test scripts/community-moderation.test.mjs scripts/community-worker.test.mjs scripts/community-media-cleanup.test.mjs scripts/community-dev-maintenance.test.mjs && python3 scripts/test-backup-dev-encrypted.py && python3 scripts/test-restore-dev-quarantined.py",
    "test:ai-eval": "node --import tsx scripts/run-ai-evaluation.mjs",
    "check": "node scripts/run-check.mjs",
    "test:dev-ios-apple-auth": "node scripts/test-dev-ios-apple-auth.mjs",
    "nav:read": "node scripts/navigation/read.mjs",
    "navigation:bench": "node scripts/navigation/bench.mjs",
    "analytics:dashboard": "node --import tsx scripts/analytics-dashboard/live.mjs",
    "analytics:dashboard:refresh": "node --import tsx scripts/analytics-dashboard/collect.mjs",
    "analytics:dashboard:provision": "node scripts/analytics-dashboard/metabase.mjs",
    "analytics:dashboard:verify-live": "node --import tsx scripts/analytics-dashboard/verify-live.mjs",
    "analytics:dashboard:verify-db": "node --import tsx scripts/analytics-dashboard/verify-local.mjs",
    "analytics:dashboard:verify-metabase": "node scripts/analytics-dashboard/verify-metabase-local.mjs",
    "test:analytics-dashboard": "node --import tsx --test scripts/analytics-dashboard/snapshot.test.mjs scripts/analytics-dashboard/metabase.test.mjs scripts/analytics-dashboard/local.test.mjs scripts/analytics-dashboard/demo.test.mjs scripts/analytics-dashboard/live.test.mjs scripts/analytics-dashboard/collect.test.mjs",
    "analytics:dashboard:verify-init": "node scripts/analytics-dashboard/verify-compose-init.mjs",
    "analytics:dashboard:local": "node --import tsx scripts/analytics-dashboard/local.mjs",
    "analytics:dashboard:demo": "node --import tsx scripts/analytics-dashboard/demo.mjs",
    "test:coach-feature-knowledge": "node --test scripts/check-coach-feature-knowledge.test.mjs && node --import tsx scripts/check-coach-feature-knowledge.mjs",
    "check:steps": "pnpm test:check-runner && pnpm navigation:check && pnpm test:navigation && pnpm test:exercise-catalog && pnpm test:coach-feature-knowledge && pnpm format:check && pnpm typecheck && pnpm --filter @mizyun/mobile bundle:check && pnpm test && pnpm test:analytics-dashboard && pnpm test:deployment-safeguards && pnpm test:hetzner-operations && pnpm test:backup-retention && pnpm test:google-oauth-config && pnpm test:build-matrix && pnpm test:production-android-signing-tooling && pnpm test:production-ios-ipa-tooling && pnpm test:ai-eval && pnpm test:community-operations && pnpm test:dev-ios-apple-auth && pnpm test:ios-simulator",
    "test:check-runner": "node --test scripts/run-check.test.mjs",
    "mobile:simulator:ios": "node scripts/ios-simulator-dev.mjs",
    "test:ios-simulator": "node --test scripts/ios-simulator-dev.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "supabase": "2.109.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
