[Unit]
Description=Mizyun self-hosted Supabase development stack
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=mizyun
Group=mizyun
WorkingDirectory=/srv/mizyun/dev/supabase
ExecStart=/usr/bin/docker compose -p mizyun-dev -f docker-compose.yml up -d --wait
ExecStop=/usr/bin/docker compose -p mizyun-dev -f docker-compose.yml down
RemainAfterExit=true
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
