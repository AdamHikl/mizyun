NODE_ENV=production
MIZYUN_ENV=development
API_HOST=127.0.0.1
API_PORT=4100

SUPABASE_URL=http://127.0.0.1:8100
SUPABASE_PUBLIC_URL=https://mizyun-supabase-dev.phiskel.com
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MIZYUN_DEV_DB_URL=postgresql://postgres:REPLACE_WITH_DEV_POSTGRES_PASSWORD@127.0.0.1:5433/postgres

MIZYUN_API_SERVICE=mizyun-api-dev
MIZYUN_LOCAL_API_URL=http://127.0.0.1:4100

GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://mizyun-supabase-dev.phiskel.com/auth/v1/callback

AGENT_PROVIDER=gemini
VISION_PROVIDER=disabled
AI_EXTERNAL_ACCESS=true
AI_DAILY_USER_TOKEN_BUDGET=50000
AI_USER_REQUESTS_PER_MINUTE=10
AI_USER_MAX_CONCURRENT_REQUESTS=1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=2048

# Per-feature AI vendor (gemini | anthropic); unset inherits AGENT_PROVIDER.
# Anthropic routes need ANTHROPIC_API_KEY and ANTHROPIC_DEV_TESTING=true
# (ADR-0069, Dev testing only). Dev benchmark routing (2026-10-20):
# ANTHROPIC_API_KEY=
# ANTHROPIC_DEV_TESTING=true
# COACH_PROVIDER=anthropic
# MEAL_TEXT_PROVIDER=anthropic
# MEAL_PHOTO_PROVIDER=gemini
# ACTIVITY_DRAFT_PROVIDER=anthropic
# RECIPE_IDEAS_PROVIDER=anthropic
# INGREDIENT_PHOTO_PROVIDER=gemini
# COOKING_ASSISTANT_PROVIDER=gemini
# STRETCH_PLAN_PROVIDER=gemini
# AI_CONSENT_ACCEPTED_VERSIONS=2026-10-20
