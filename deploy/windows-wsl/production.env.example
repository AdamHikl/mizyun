# Install as /etc/mizyun/production.env inside Ubuntu/WSL.
# Replace every placeholder, then: sudo chown root:mizyun <file>; sudo chmod 0640 <file>
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=4000

SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLIC_URL=https://mizyun-supabase.phiskel.com
SUPABASE_PUBLISHABLE_KEY=<self-hosted-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<self-hosted-secret-key>

# Used only by the promotion script. Percent-encode special password characters.
MIZYUN_PRODUCTION_DB_URL=postgresql://postgres:<password>@127.0.0.1:5432/postgres
MIZYUN_PRODUCTION_DB_DIRECT_CONTAINER=true
MIZYUN_PRODUCTION_DB_SSLMODE=disable
MIZYUN_BACKUP_DIR=/srv/mizyun/backups
MIZYUN_STORAGE_DIR=/srv/mizyun/supabase/volumes/storage
MIZYUN_DB_CONTAINER=supabase-db
MIZYUN_API_SERVICE=mizyun-api
MIZYUN_LOCAL_API_URL=http://127.0.0.1:4000

AGENT_PROVIDER=gemini
VISION_PROVIDER=disabled
AI_EXTERNAL_ACCESS=true
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_VISION_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_VISION_THINKING_BUDGET=0
GEMINI_VISION_TIMEOUT_MS=45000
GEMINI_VISION_MAX_OUTPUT_TOKENS=8192
AI_DAILY_USER_TOKEN_BUDGET=100000
AI_USER_REQUESTS_PER_MINUTE=6
AI_USER_MAX_CONCURRENT_REQUESTS=1
