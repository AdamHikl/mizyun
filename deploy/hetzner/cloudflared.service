[Unit]
Description=Cloudflare Tunnel client for Mizyun on Hetzner
After=network-online.target mizyun-api.service mizyun-api-dev.service
# Pull in the origins at startup without coupling this shared transport to
# either API's stop/restart lifecycle. Release readiness is checked separately.
Wants=network-online.target mizyun-api.service mizyun-api-dev.service
OnFailure=mizyun-alert@%n.service

[Service]
TimeoutStartSec=30
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
