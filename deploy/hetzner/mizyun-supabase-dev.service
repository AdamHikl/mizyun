[Unit]
Description=Mizyun Supabase development stack on Hetzner
Wants=network-online.target
After=network-online.target docker.service mizyun-supabase.service
Requires=docker.service
OnFailure=mizyun-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/lib/mizyun/dev/supabase
ExecStart=/usr/bin/docker compose up -d --wait
ExecStop=/usr/bin/docker compose stop
RemainAfterExit=true
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
