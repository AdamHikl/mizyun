[Unit]
Description=Mizyun development API on Hetzner
Wants=network-online.target
After=network-online.target mizyun-supabase-dev.service
Requires=mizyun-supabase-dev.service

[Service]
Type=simple
User=mizyun-dev-api
Group=mizyun-dev-api
WorkingDirectory=/var/lib/mizyun/dev/repo
EnvironmentFile=/etc/mizyun/dev.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp XDG_CACHE_HOME=/tmp
# Start node directly from apps/api (the directory `pnpm --filter` used to
# enter); `exec` leaves node as the only process. The pnpm and tsx CLI
# wrappers stayed resident and cost about 60 MiB per environment.
ExecStart=/bin/sh -c 'cd apps/api && exec /usr/local/bin/node --import tsx src/server.ts'
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
InaccessiblePaths=/etc/mizyun/production.env /var/lib/mizyun/repo /srv/mizyun/supabase /srv/mizyun/migration /var/run/docker.sock
ReadWritePaths=/var/lib/mizyun/dev/repo /tmp
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
