#!/usr/bin/env bash
set -Eeuo pipefail

# Narrow root helper for the non-root Production deploy user. It exposes only
# the single private Docker-network address of the fixed Production DB.
mapfile -t addresses < <(
  docker inspect -f '{{range .NetworkSettings.Networks}}{{println .IPAddress}}{{end}}' supabase-db |
    sed '/^$/d'
)
if (( ${#addresses[@]} != 1 )) || [[ ! "${addresses[0]}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  echo "Expected exactly one IPv4 address for supabase-db." >&2
  exit 1
fi
printf '%s\n' "${addresses[0]}"
