# Template for apps/api/.env.test (gitignored). Copy to `.env.test`
# and fill with the values from `pnpm db:status` on the local Supabase
# stack. The opt-in e2e suite reads these keys via vitest.config.ts.
#
#   cp apps/api/.env.test.example apps/api/.env.test
#   pnpm db:status | head -20   # capture the API URL, anon, publishable,
#                               # service-role, and Mailpit URL
#
# Never commit a populated `.env.test`. Never paste the keys into the
# command line — both leak through shell transcripts and tool input.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MAILPIT_URL=