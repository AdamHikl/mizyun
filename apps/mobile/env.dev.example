# Copy to apps/mobile/.env.local for the Dev app, then fill in the Mac's
# reachable development URLs and local publishable key.
EXPO_PUBLIC_API_URL=http://<mac-tailscale-ip>:4000
EXPO_PUBLIC_SUPABASE_URL=http://<mac-tailscale-ip>:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<development-anon-key>
EXPO_PUBLIC_AUTH_REDIRECT_URI=mizyun-dev://auth/callback
