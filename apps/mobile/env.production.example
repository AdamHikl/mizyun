# Copy to apps/mobile/.env.local for the Production app, then fill in the
# publishable key from the PC's /srv/mizyun/supabase/.env (ANON_KEY).
EXPO_PUBLIC_API_URL=https://mizyun-api.phiskel.com
EXPO_PUBLIC_SUPABASE_URL=https://mizyun-supabase.phiskel.com
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<production-anon-key>
EXPO_PUBLIC_AUTH_REDIRECT_URI=mizyun://auth/callback
