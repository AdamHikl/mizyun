{
  "name": "@mizyun/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.4",
    "@mizyun/adapter-supabase-mobile": "workspace:*",
    "@mizyun/api-client": "workspace:*",
    "@mizyun/config": "workspace:*",
    "@mizyun/contracts": "workspace:*",
    "@mizyun/core": "workspace:*",
    "@mizyun/identity": "workspace:*",
    "@mizyun/observability": "workspace:*",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-file-system": "57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "57.0.2",
    "expo-image-picker": "57.0.2",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "bundle:check": "pnpm bundle:check:ios && pnpm bundle:check:android",
    "bundle:check:ios": "EXPO_NO_TELEMETRY=1 expo export --platform ios --clear --output-dir dist/bundle-check-ios",
    "bundle:check:android": "EXPO_NO_TELEMETRY=1 expo export --platform android --clear --output-dir dist/bundle-check-android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
