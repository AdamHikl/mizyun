NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# Public mobile configuration. For local development, copy the API URL and
# publishable key reported by `pnpm db:status` after `pnpm db:start`.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix secrets with EXPO_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Apple deletion recovery: canonical base64 encoding of 32 random bytes.
# Keep each environment's key stable while revocation jobs are pending (ADR-0050).
APPLE_REVOCATION_ENCRYPTION_KEY=

# Founder testing mode keeps implemented AI features enabled by default.
# AGENT_PROVIDER: disabled | gemini | anthropic (see ANTHROPIC_* below).
# "disabled" (the default when unset) switches Coach chat off even when
# COACH_PROVIDER or an AI key is set.
# Never place the Gemini or Anthropic key in an EXPO_PUBLIC_ variable or a committed
# environment file. See docs/FOUNDER_TESTING_MODE.md.
AGENT_PROVIDER=gemini
# VISION-001 — set to "stub" for local dev + the vision:smoke
# script; "disabled" returns 503 on the photo-draft endpoint.
# Ignored when GEMINI_VISION_API_KEY or GEMINI_API_KEY is configured
# (production always uses Gemini).
VISION_PROVIDER=disabled

# Google AI Studio Gemini configuration (Gemini 3.8 Flash / 3.6 Flash fallback).
# Single key supports both text coach and vision nutrition drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_VISION_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_VISION_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_VISION_THINKING_BUDGET=0
GEMINI_VISION_TIMEOUT_MS=45000
GEMINI_VISION_MAX_OUTPUT_TOKENS=8192
# ADR-0069 — Anthropic Claude (Haiku 5.5) for Coach, meal drafts and recipes.
# Used for every feature that routes to anthropic (AGENT_PROVIDER=anthropic or a
# per-feature *_PROVIDER key below). With AGENT_PROVIDER=anthropic and no key the
# API keeps using Gemini. Meal illustrations always use Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_VISION_TIMEOUT_MS=45000
ANTHROPIC_MAX_OUTPUT_TOKENS=8192
ANTHROPIC_WEB_SEARCH=true
# Required acknowledgement for any anthropic route (ADR-0078). Dev's older
# ANTHROPIC_DEV_TESTING=true is still accepted as an alias.
ANTHROPIC_ENABLED=false
# Per-feature AI vendor: gemini | anthropic. Empty inherits AGENT_PROVIDER.
# An explicit value never falls back: config fails if that vendor's key is
# missing, and any anthropic route needs ANTHROPIC_ENABLED=true. A request
# reaches Anthropic only for a feature the user's stored AI consent names
# Anthropic for (2026-10-20 or later: Coach, typed meal estimates and draft
# changes, Log activity); every other feature and older consent is served by
# Gemini, whatever these keys say (ADR-0078).
# Dev and Production routing: Coach, typed meal estimates and refinement and
# activity drafts on anthropic; recipe ideas, every photo draft, ingredient
# photos, the cooking assistant and stretch on gemini.
COACH_PROVIDER=
MEAL_TEXT_PROVIDER=
MEAL_PHOTO_PROVIDER=
ACTIVITY_DRAFT_PROVIDER=
RECIPE_IDEAS_PROVIDER=
INGREDIENT_PHOTO_PROVIDER=
COOKING_ASSISTANT_PROVIDER=
STRETCH_PLAN_PROVIDER=
AI_DAILY_USER_TOKEN_BUDGET=100000
AI_USER_REQUESTS_PER_MINUTE=6
AI_USER_MAX_CONCURRENT_REQUESTS=1
AI_EXTERNAL_ACCESS=true
# Consent versions the server accepts (ADR-0077). Unset accepts 2026-09-08,
# 2026-10-20 and 2026-10-21; Dev sets 2026-10-20,2026-10-21 so testers confirm
# the two-provider wording (new builds ask again for 2026-10-21).
AI_CONSENT_ACCEPTED_VERSIONS=

# AWS SES Email Delivery (SES-EMAIL-001)
# Regional settings and IAM access keys for sending from @mizyun.phiskel.com
SES_REGION=eu-west-1
SES_FROM_EMAIL="Mizyun <no-reply@mizyun.phiskel.com>"
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
