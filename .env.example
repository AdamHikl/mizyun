NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# Public mobile configuration. These are intentionally blank until Supabase is created.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix secrets with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Model-provider setup is deliberately deferred. See docs/BEFORE_TESTING.md.
AGENT_PROVIDER=disabled
