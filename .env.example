NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# Public mobile configuration. For local development, copy the API URL and
# publishable key reported by `pnpm db:status` after `pnpm db:start`.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix secrets with EXPO_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Model-provider setup is deliberately deferred. See docs/BEFORE_TESTING.md.
AGENT_PROVIDER=disabled
