NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# Public mobile configuration. For local development, copy the API URL and
# publishable key reported by `pnpm db:status` after `pnpm db:start`.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix secrets with EXPO_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI is disabled by default. Never place MISTRAL_API_KEY in an EXPO_PUBLIC_
# variable or a committed environment file. Synthetic live calls require the
# separate gate in docs/BEFORE_TESTING.md.
AGENT_PROVIDER=disabled
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_TIMEOUT_MS=30000
MISTRAL_MAX_OUTPUT_TOKENS=1200
AI_DAILY_USER_TOKEN_BUDGET=100000
AI_EXTERNAL_ACCESS=false
