NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# Public mobile configuration. For local development, copy the API URL and
# publishable key reported by `pnpm db:status` after `pnpm db:start`.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix secrets with EXPO_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Founder testing mode keeps implemented AI features enabled by default.
# Never place either Mistral key in an EXPO_PUBLIC_ variable or a committed
# environment file. See docs/FOUNDER_TESTING_MODE.md.
AGENT_PROVIDER=mistral
# VISION-001 — set to "stub" for local dev + the vision:smoke
# script; "disabled" (default) returns 503 on the photo-draft
# endpoint. Ignored when MISTRAL_VISION_API_KEY is configured
# (production always uses Mistral).
VISION_PROVIDER=disabled
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_MODERATION_MODEL=mistral-moderation-2603
MISTRAL_TIMEOUT_MS=30000
MISTRAL_MAX_OUTPUT_TOKENS=1200
# VISION-001 — Mistral vision workspace. Separate key + model
# from the text coach (ADR-0017 §"Per-feature Mistral
# workspaces"). Omit both to keep the draft endpoint disabled
# (returns VisionProviderError("not_configured")).
MISTRAL_VISION_API_KEY=
# Official Mistral vision model; keep the text model setting above separate.
MISTRAL_VISION_MODEL=mistral-medium-2508
MISTRAL_VISION_TIMEOUT_MS=45000
MISTRAL_VISION_MAX_OUTPUT_TOKENS=1200
# Google AI Studio Gemini configuration (for Gemini 3.7 Flash).
# Single key supports both text coach and vision nutrition drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_VISION_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_VISION_TIMEOUT_MS=45000
GEMINI_VISION_MAX_OUTPUT_TOKENS=8192
AI_DAILY_USER_TOKEN_BUDGET=100000
AI_USER_REQUESTS_PER_MINUTE=6
AI_USER_MAX_CONCURRENT_REQUESTS=1
AI_EXTERNAL_ACCESS=true

